{
  "schemaVersion": 1,
  "id": "ssha_hotm_addon",
  "version": "${version}",
  "name": "Siege's SkyHanni Addons (SSHA)",
  "description": "Siege's independent SkyHanni addons: HOTM progress, commissions, and active-time commissions per hour.",
  "authors": ["Siegeisok67"],
  "contact": {
    "homepage": "https://github.com/Siegeisok67/SSHA",
    "sources": "https://github.com/Siegeisok67/SSHA",
    "issues": "https://github.com/Siegeisok67/SSHA/issues"
  },
  "environment": "client",
  "mixins": ["ssha.mixins.json"],
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.ssha.hotm.HotmAddon"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.155.2+26.2",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "skyhanni": ">=9.0.0"
  }
}
